DATABASE_URL=postgresql+psycopg2://afaq:afaq@localhost:5432/afaq

# The frontend's address(es), comma-separated, allowed to call the API from a browser.
AFAQ_CORS_ORIGINS=http://localhost:3000

# Optional — only needed once LLM synthesis (section D phrasing) is wired in.
# Never expose these in the frontend; the backend reads them server-side only.
ANTHROPIC_API_KEY=

# Researchers who may review the curated comparisons at /review.
# "name:token;name:token" — tokens of at least 16 characters, kept secret, never committed.
AFAQ_REVIEWERS=

# «الذكاء الاصطناعي في الإعجاز العلمي» — the AI platform the section sends verses to.
# "mock" (default) is test mode: no network, a placeholder report.
# "openai" is the research platform: OpenAI Responses API with Web Search, File Search
# (when vector stores are set) and Structured Outputs. The key stays on the server.
AFAQ_AI_PROVIDER=mock
OPENAI_API_KEY=
# gpt-6.1-sol: checked against OpenAI's model docs on 2026-10-05; gpt-6-astra is the stronger, costlier one.
OPENAI_MODEL=gpt-6.1-sol
# low | medium | high | xhigh | max — more effort: deeper research, slower and costlier.
OPENAI_REASONING_EFFORT=high
# Comma-separated OpenAI vector stores of reference books AFAQ does not hold (File Search); optional.
OPENAI_VECTOR_STORE_IDS=
# "0" turns Web Search off (then no scientific source can be verified).
OPENAI_WEB_SEARCH=1
# Seconds the platform may stay silent while researching.
AFAQ_AI_TIMEOUT=600
# "http": any OpenAI-compatible chat-completions platform, without tools.
AFAQ_AI_API_URL=
AFAQ_AI_API_KEY=
AFAQ_AI_MODEL=
# Reports per client address per hour once a paid platform is connected (0 = unlimited).
AFAQ_AI_HOURLY_LIMIT=10
