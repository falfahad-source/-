DATABASE_URL=postgresql+psycopg2://afaq:afaq@localhost:5432/afaq

# The frontend's address(es), comma-separated, allowed to call the API from a browser.
AFAQ_CORS_ORIGINS=http://localhost:3000

# Optional — only needed once LLM synthesis (section D phrasing) is wired in.
# Never expose these in the frontend; the backend reads them server-side only.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Researchers who may review the curated comparisons at /review.
# "name:token;name:token" — tokens of at least 16 characters, kept secret, never committed.
AFAQ_REVIEWERS=

# «الذكاء الاصطناعي في الإعجاز العلمي» — the AI platform the section sends verses to.
# "mock" (default) is test mode: no network, a placeholder report. Set "http" once the
# platform's API is available (OpenAI-compatible chat-completions endpoint).
AFAQ_AI_PROVIDER=mock
AFAQ_AI_API_URL=
AFAQ_AI_API_KEY=
AFAQ_AI_MODEL=
# Reports per client address per hour once a paid platform is connected (0 = unlimited).
AFAQ_AI_HOURLY_LIMIT=10
